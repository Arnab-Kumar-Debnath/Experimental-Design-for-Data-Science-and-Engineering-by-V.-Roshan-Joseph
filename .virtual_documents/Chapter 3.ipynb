import numpy as np
import matplotlib.pyplot as plt

plt.style.use("ggplot")
data=np.linspace(0,1,10)
data2=[0.5+0.5*np.cos(np.pi*((i-0.5)/10)) for i in range(0,11)]
R_matrix=np.zeros([len(data2), len(data2)])



def R(x, theta=0.1):
    return np.exp(-((x**2)/(theta**2)))




for i in range(len(data2)):
    for j in range(len(data2)):
        R_matrix[i,j]=R(data2[i]-data2[j])


def r(x, data=data2):
    x_R=x-data
    return R(x_R)


def s(x):
    return np.sqrt(1-r(x, data=data2).T@np.linalg.inv(R_matrix)@r(x, data=data2))


x=np.linspace(0,1,1000)


s_=[]
for i in x:
    s_.append(s(i))


plt.plot(s_)


